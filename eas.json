{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "internal-testflight",
        "EXPO_PUBLIC_MONETIZATION_MODE": "native",
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "true",
        "FREED_ENCRYPTED_DNS_RELEASE_ENABLED": "true"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "5477978760-ussf6lsalc0h97ra505g8hfe6h7h5ns8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "5477978760-mqacbd3saauk1roatvf9rpujvpkv8i7b.apps.googleusercontent.com",
