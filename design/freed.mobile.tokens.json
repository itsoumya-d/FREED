{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "org.mobile-native": {
      "subject": "FREED protection and recovery",
      "designDials": {
        "density": "balanced",
        "contrast": "clear",
        "shape": "rounded-but-restrained",
        "typography": "neutral-system",
        "motion": "responsive-minimal"
      },
      "logicalUnits": {
        "swiftui": "pt",
        "compose": "dp",
        "reactNative": "DIP",
        "flutter": "logicalPixel"
      },
      "profiles": {
        "base": {
          "overrides": {}
        },
        "light": {
          "extends": "base",
          "overrides": {}
        },
        "dark": {
          "extends": "base",
          "overrides": {
            "color.surface.canvas": "#101319",
            "color.surface.default": "#1D222B",
            "color.content.primary": "#F5F6FA",
            "color.content.secondary": "#BDC5D4",
            "color.action.primary": "#A1ADFF",
            "color.action.onPrimary": "#141827",
            "color.status.protected": "#9FDCBB",
            "color.status.attention": "#F1D18A",
            "color.status.unprotected": "#FFA4A4",
            "color.surface.raised": "#272E39",
            "color.surface.selected": "#2D3554",
            "color.content.disabled": "#A5AFC2",
            "color.border.subtle": "#3C4659"
          }
        },
        "highContrast": {
          "extends": "light",
          "overrides": {
            "color.surface.canvas": "#FFFFFF",
            "color.surface.default": "#FFFFFF",
            "color.content.primary": "#000000",
            "color.content.secondary": "#202020",
            "color.border.subtle": "#000000",
            "color.action.primary": "#00552E",
            "color.action.onPrimary": "#FFFFFF",
            "stroke.focus": 3
          }
        },
        "ios": {
          "extends": "base",
          "overrides": {
            "touchTarget.minimum": 44,
            "layout.margin.compact": 24,
            "component.navigation.barHeight": 44
          }
        },
        "android": {
          "extends": "base",
          "overrides": {
            "touchTarget.minimum": 48,
            "layout.margin.compact": 24,
            "component.navigation.barHeight": 64
          }
        },
        "reducedMotion": {
          "extends": "base",
          "overrides": {
            "motion.duration.instant": {
              "value": 0,
              "unit": "ms"
            },
            "motion.duration.fast": {
              "value": 0,
              "unit": "ms"
            },
            "motion.duration.standard": {
              "value": 0,
              "unit": "ms"
            },
            "motion.duration.slow": {
              "value": 0,
              "unit": "ms"
            },
            "motion.distance.standard": 0,
            "motion.stagger.short": {
              "value": 0,
              "unit": "ms"
            },
            "motion.stagger.standard": {
              "value": 0,
              "unit": "ms"
            }
          }
        }
      }
    },
    "org.freed.momentum": {
      "version": 1,
      "palettes": {
        "light": {
          "bg": "#FAFAFB",
          "bgDeep": "#F0F1F6",
          "surface": "#FFFFFF",
          "surface2": "#F0F2F8",
          "surface3": "#E5E8F1",
          "text": "#141827",
          "text2": "#50586B",
          "text3": "#626C80",
          "accent": "#414ACE",
          "onAccent": "#FFFFFF",
          "accentTint": "#E6E9FF",
          "heroSurface": "#EEF0FF",
          "border": "#D9DEEA",
          "red": "#B8343C",
          "red2": "#A92C35",
          "warning": "#825600",
          "success": "#216446",
          "commitmentSurface": "#FFE087",
          "movementSurface": "#CBF28A",
          "reflectionSurface": "#D0CCFF",
          "calmSurface": "#FFACA2",
          "practiceInk": "#141827",
          "sky": "#414ACE",
          "white": "#FFFFFF",
          "black": "#101319",
          "onTint": "#E0F2E7",
          "offTint": "#FCE7E8",
          "attentionTint": "#FFF0D0",
          "commitmentPanelSurface": "#FFF4D5",
          "movementPanelSurface": "#EBF5DC",
          "reflectionPanelSurface": "#EEEDFF",
          "calmPanelSurface": "#FDEAE6",
          "commitmentPanelAccent": "#735400",
          "movementPanelAccent": "#396000",
          "reflectionPanelAccent": "#514E93",
          "calmPanelAccent": "#974138"
        },
        "dark": {
          "bg": "#101319",
          "bgDeep": "#0B0E14",
          "surface": "#1D222B",
          "surface2": "#272E39",
          "surface3": "#333D4D",
          "text": "#F5F6FA",
          "text2": "#BDC5D4",
          "text3": "#A5AFC2",
          "accent": "#A1ADFF",
          "onAccent": "#141827",
          "accentTint": "#2D3554",
          "heroSurface": "#252C3D",
          "border": "#3C4659",
          "red": "#FFA4A4",
          "red2": "#FFB8B8",
          "warning": "#F1D18A",
          "success": "#9FDCBB",
          "commitmentSurface": "#F3D17B",
          "movementSurface": "#BCE77D",
          "reflectionSurface": "#BFC1F2",
          "calmSurface": "#F79C91",
          "practiceInk": "#141827",
          "sky": "#A1ADFF",
          "white": "#F5F6FA",
          "black": "#101319",
          "onTint": "#19372B",
          "offTint": "#402428",
          "attentionTint": "#3E321C",
          "commitmentPanelSurface": "#292720",
          "movementPanelSurface": "#242C23",
          "reflectionPanelSurface": "#272936",
          "calmPanelSurface": "#302625",
          "commitmentPanelAccent": "#F3D17B",
          "movementPanelAccent": "#BCE77D",
          "reflectionPanelAccent": "#BFC1F2",
          "calmPanelAccent": "#F79C91"
        }
      },
      "categories": {
        "commitment": "yellow",
        "movement": "lime",
        "reflection": "lilac",
        "calm": "coral"
      }
    }
  },
  "primitive": {
    "$description": "Raw source values are private to token aliases; handwritten consumers use semantic paths only."
  },
  "color": {
    "$type": "color",
    "primitive": {
      "ink": {
        "$value": "#141827"
      },
      "paper": {
        "$value": "#FFFFFF"
      },
      "mist": {
        "$value": "#FAFAFB"
      },
      "sage": {
        "$value": "#E6E9FF"
      },
      "forest": {
        "$value": "#414ACE"
      },
      "mint": {
        "$value": "#55C98B"
      },
      "amber": {
        "$value": "#825600"
      },
      "red": {
        "$value": "#B8343C"
      },
      "blue": {
        "$value": "#414ACE"
      },
      "transparent": {
        "$value": "#00000000"
      }
    },
    "surface": {
      "canvas": {
        "$value": "{color.primitive.mist}"
      },
      "default": {
        "$value": "{color.primitive.paper}"
      },
      "raised": {
        "$value": "{color.primitive.paper}"
      },
      "selected": {
        "$value": "{color.primitive.sage}"
      }
    },
    "content": {
      "primary": {
        "$value": "{color.primitive.ink}"
      },
      "secondary": {
        "$value": "#50586B"
      },
      "inverse": {
        "$value": "{color.primitive.paper}"
      },
      "disabled": {
        "$value": "#626C80"
      }
    },
    "border": {
      "subtle": {
        "$value": "#D9DEEA"
      },
      "strong": {
        "$value": "#626C80"
      },
      "focus": {
        "$value": "{color.primitive.blue}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.primitive.forest}"
      },
      "onPrimary": {
        "$value": "{color.primitive.paper}"
      },
      "secondary": {
        "$value": "{color.primitive.sage}"
      },
      "onSecondary": {
        "$value": "{color.primitive.ink}"
      }
    },
    "status": {
      "protected": {
        "$value": "#216446"
      },
      "attention": {
        "$value": "{color.primitive.amber}"
      },
      "unprotected": {
        "$value": "{color.primitive.red}"
      },
      "informative": {
        "$value": "{color.primitive.blue}"
      }
    }
  },
  "semantic": {
    "$type": "color",
    "status": {
      "protected": {
        "$value": "{color.status.protected}"
      },
      "attention": {
        "$value": "{color.status.attention}"
      },
      "unprotected": {
        "$value": "{color.status.unprotected}"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.38
    },
    "pressed": {
      "$value": 0.86
    },
    "scrim": {
      "$value": 0.48
    },
    "subtle": {
      "$value": 0.72
    }
  },
  "typography": {
    "$type": "typography",
    "largeTitle": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 34,
        "fontWeight": 800,
        "letterSpacing": -0.4,
        "lineHeight": 41
      }
    },
    "title": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 28,
        "fontWeight": 700,
        "letterSpacing": -0.2,
        "lineHeight": 34
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 20,
        "fontWeight": 700,
        "letterSpacing": 0,
        "lineHeight": 26
      }
    },
    "body": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 17,
        "fontWeight": 400,
        "letterSpacing": 0,
        "lineHeight": 24
      }
    },
    "label": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 15,
        "fontWeight": 600,
        "letterSpacing": 0.1,
        "lineHeight": 20
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "system",
        "fontSize": 13,
        "fontWeight": 500,
        "letterSpacing": 0.2,
        "lineHeight": 18
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": {
      "$value": 0
    },
    "2": {
      "$value": 2
    },
    "4": {
      "$value": 4
    },
    "8": {
      "$value": 8
    },
    "12": {
      "$value": 12
    },
    "16": {
      "$value": 16
    },
    "20": {
      "$value": 20
    },
    "24": {
      "$value": 24
    },
    "32": {
      "$value": 32
    },
    "40": {
      "$value": 40
    },
    "48": {
      "$value": 48
    },
    "64": {
      "$value": 64
    }
  },
  "sizing": {
    "$type": "dimension",
    "control": {
      "$value": 52
    },
    "controlCompact": {
      "$value": 44
    },
    "statusIndicator": {
      "$value": 32
    },
    "progressRing": {
      "$value": 128
    }
  },
  "iconography": {
    "$type": "dimension",
    "small": {
      "$value": 16
    },
    "medium": {
      "$value": 24
    },
    "large": {
      "$value": 32
    },
    "hero": {
      "$value": 48
    }
  },
  "touchTarget": {
    "$type": "dimension",
    "minimum": {
      "$value": 48
    },
    "comfortable": {
      "$value": 52
    },
    "spacious": {
      "$value": 56
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": 0
    },
    "small": {
      "$value": 8
    },
    "medium": {
      "$value": 12
    },
    "large": {
      "$value": 20
    },
    "extraLarge": {
      "$value": 28
    },
    "pill": {
      "$value": 999
    }
  },
  "stroke": {
    "$type": "dimension",
    "hairline": {
      "$value": 0.5
    },
    "standard": {
      "$value": 1
    },
    "strong": {
      "$value": 2
    },
    "focus": {
      "$value": 2
    }
  },
  "elevation": {
    "flat": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": 0,
        "offsetY": 0,
        "blur": 0,
        "spread": 0
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "#10231A1F",
        "offsetX": 0,
        "offsetY": 2,
        "blur": 10,
        "spread": 0
      }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "color": "#10231A33",
        "offsetX": 0,
        "offsetY": 8,
        "blur": 32,
        "spread": 0
      }
    },
    "material": {
      "$type": "number",
      "level0": {
        "$value": 0
      },
      "level1": {
        "$value": 1
      },
      "level3": {
        "$value": 3
      }
    }
  },
  "layout": {
    "margin": {
      "$type": "dimension",
      "compact": {
        "$value": 24
      },
      "medium": {
        "$value": 24
      },
      "expanded": {
        "$value": 32
      }
    },
    "gutter": {
      "$type": "dimension",
      "compact": {
        "$value": 12
      },
      "medium": {
        "$value": 16
      },
      "expanded": {
        "$value": 24
      }
    },
    "window": {
      "$type": "dimension",
      "compactMax": {
        "$value": 599
      },
      "mediumMax": {
        "$value": 839
      },
      "expandedMin": {
        "$value": 840
      }
    },
    "columns": {
      "$type": "number",
      "compact": {
        "$value": 4
      },
      "medium": {
        "$value": 8
      },
      "expanded": {
        "$value": 12
      }
    },
    "contentMax": {
      "$type": "dimension",
      "$value": 960
    },
    "safeAreaPolicy": {
      "$type": "string",
      "$value": "system-insets"
    }
  },
  "zIndex": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 10
    },
    "overlay": {
      "$value": 20
    },
    "modal": {
      "$value": 30
    },
    "toast": {
      "$value": 40
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "standard": {
        "$value": {
          "value": 220,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 260,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "entrance": {
        "$value": [
          0,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.3,
          0,
          1,
          1
        ]
      }
    },
    "spring": {
      "$type": "spring",
      "responsive": {
        "$value": {
          "mass": 1,
          "stiffness": 310,
          "damping": 28
        }
      },
      "expressive": {
        "$value": {
          "mass": 1,
          "stiffness": 220,
          "damping": 20
        }
      }
    },
    "stagger": {
      "$type": "duration",
      "short": {
        "$value": {
          "value": 32,
          "unit": "ms"
        }
      },
      "standard": {
        "$value": {
          "value": 56,
          "unit": "ms"
        }
      }
    },
    "distance": {
      "$type": "dimension",
      "standard": {
        "$value": 16
      }
    }
  },
  "haptic": {
    "$type": "string",
    "selection": {
      "$value": "selection"
    },
    "impactLight": {
      "$value": "impact-light"
    },
    "success": {
      "$value": "notification-success"
    },
    "warning": {
      "$value": "notification-warning"
    },
    "error": {
      "$value": "notification-error"
    }
  },
  "component": {
    "button": {
      "minimumHeight": {
        "$type": "dimension",
        "$value": "{touchTarget.minimum}"
      },
      "horizontalPadding": {
        "$type": "dimension",
        "$value": "{spacing.20}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.medium}"
      },
      "primaryBackground": {
        "$type": "color",
        "$value": "{color.action.primary}"
      },
      "primaryContent": {
        "$type": "color",
        "$value": "{color.action.onPrimary}"
      },
      "disabledOpacity": {
        "$type": "number",
        "$value": "{opacity.disabled}"
      },
      "pressedOpacity": {
        "$type": "number",
        "$value": "{opacity.pressed}"
      }
    },
    "iconButton": {
      "minimumSize": {
        "$type": "dimension",
        "$value": "{touchTarget.minimum}"
      },
      "iconSize": {
        "$type": "dimension",
        "$value": "{iconography.medium}"
      }
    },
    "textField": {
      "minimumHeight": {
        "$type": "dimension",
        "$value": "{touchTarget.comfortable}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.medium}"
      },
      "border": {
        "$type": "dimension",
        "$value": "{stroke.standard}"
      },
      "focusBorder": {
        "$type": "dimension",
        "$value": "{stroke.focus}"
      }
    },
    "card": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.20}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.large}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.surface.default}"
      }
    },
    "listRow": {
      "minimumHeight": {
        "$type": "dimension",
        "$value": 56
      },
      "verticalPadding": {
        "$type": "dimension",
        "$value": "{spacing.12}"
      }
    },
    "navigation": {
      "barHeight": {
        "$type": "dimension",
        "$value": 56
      },
      "iconSize": {
        "$type": "dimension",
        "$value": "{iconography.medium}"
      }
    },
    "modal": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.extraLarge}"
      },
      "scrimOpacity": {
        "$type": "number",
        "$value": "{opacity.scrim}"
      }
    }
  },
  "state": {
    "$type": "string",
    "default": {
      "$value": "default"
    },
    "pressed": {
      "$value": "pressed"
    },
    "focused": {
      "$value": "focused"
    },
    "selected": {
      "$value": "selected"
    },
    "disabled": {
      "$value": "disabled"
    },
    "loading": {
      "$value": "loading"
    },
    "empty": {
      "$value": "empty"
    },
    "error": {
      "$value": "error"
    }
  }
}
