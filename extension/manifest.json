{
  "manifest_version": 3,
  "name": "FREED — Adult Content Blocker",
  "short_name": "FREED",
  "version": "1.0.0",
  "description": "Precision adult-domain blocking that keeps normal browsing open. Part of the FREED recovery companion.",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FREED Guard",
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "freed_adult_domains",
        "enabled": true,
        "path": "rules/adult-blocklist.json"
      }
    ]
  }
}
