<resources>
  <style name="FreedInterventionTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowLightStatusBar">@bool/freed_native_light_system_bars</item>
    <item name="android:windowLightNavigationBar">@bool/freed_native_light_system_bars</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:statusBarColor">@color/freed_native_background</item>
    <item name="android:navigationBarColor">@color/freed_native_background</item>
    <item name="android:colorAccent">@color/freed_native_action</item>
  </style>
</resources>
