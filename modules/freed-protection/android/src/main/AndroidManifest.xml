<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <activity
      android:name=".FreedInterventionActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:label="FREED"
      android:noHistory="true"
      android:theme="@style/FreedInterventionTheme" />

    <activity
      android:name=".FreedUsageAccessConfigActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/freed_usage_access_config_label"
      android:noHistory="true"
      android:theme="@style/FreedInterventionTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.USAGE_ACCESS_CONFIG" />
      </intent-filter>
      <meta-data
        android:name="android.settings.metadata.USAGE_ACCESS_REASON"
        android:resource="@string/freed_usage_access_reason" />
    </activity>

    <service
      android:name=".FreedAccessibilityService"
      android:exported="false"
      android:label="FREED Protection"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/freed_accessibility_service" />
    </service>

    <service
      android:name=".FreedVpnService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="User-enabled DNS-only VPN fallback for adult-domain filtering without full traffic proxying." />
    </service>

    <receiver
      android:name=".FreedVpnAutostartReceiver"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
