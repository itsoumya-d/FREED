# Local simulator/emulator/browser QA uses mock mode.
# Keep each active KEY= line unique; release preflight rejects duplicate active keys.
EXPO_PUBLIC_MONETIZATION_MODE=mock

# Native release or sandbox builds should switch to native and provide the platform keys below.
# EXPO_PUBLIC_MONETIZATION_MODE=native

# Store provider. Default is direct native IAP through expo-iap
# (StoreKit 2 / Google Play Billing), with RevenueCat kept as an optional
# fallback only when EXPO_PUBLIC_STORE_PROVIDER=revenuecat.
EXPO_PUBLIC_STORE_PROVIDER=native-iap
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=premium
EXPO_PUBLIC_PURCHASE_VERIFY_ENDPOINT=
EXPO_PUBLIC_PURCHASE_VERIFY_TIMEOUT_MS=8000
EXPO_PUBLIC_PURCHASE_VERIFY_RESPONSE_MAX_BYTES=256000

# Optional legacy RevenueCat fallback configuration.
# EXPO_PUBLIC_STORE_PROVIDER=revenuecat
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Store product identifiers. Defaults in code match these values.
EXPO_PUBLIC_IAP_PRODUCT_YEARLY=freed_premium_yearly
EXPO_PUBLIC_IAP_PRODUCT_MONTHLY=freed_premium_monthly
EXPO_PUBLIC_IAP_PRODUCT_LIFETIME=freed_premium_lifetime
# Future add-ons are not part of the v1 Core 3 launch.
# EXPO_PUBLIC_IAP_PRODUCT_FAMILY=freed_family_yearly
# EXPO_PUBLIC_IAP_PRODUCT_ACCOUNTABILITY=freed_accountability_monthly
# EXPO_PUBLIC_IAP_PRODUCT_AI_COACH=freed_ai_coach_monthly

# Server-only purchase verification credentials for app/api/purchases/verify.
# Never expose these with EXPO_PUBLIC_.
APP_STORE_BUNDLE_ID=app.freed.recovery
APP_STORE_SERVER_API_ENV=sandbox
FREED_PURCHASE_VERIFY_PROVIDER_TIMEOUT_MS=8000
FREED_PURCHASE_VERIFY_PROVIDER_RESPONSE_MAX_BYTES=512000
# Prefer issuer/key/private-key credentials so the server can mint short-lived JWTs.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_PRIVATE_KEY_BASE64=
# Optional pre-minted fallback for local sandbox smoke only.
APP_STORE_SERVER_API_JWT=
GOOGLE_PLAY_PACKAGE_NAME=app.freed.recovery
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
# Optional pre-minted fallback for local sandbox smoke only.
GOOGLE_PLAY_ACCESS_TOKEN=

# AdMob rewarded reset configuration.
EXPO_PUBLIC_ADMOB_APP_ID_IOS=
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_RESET_UNIT_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_RESET_UNIT_ID_ANDROID=
# Optional coarse country code for sandbox/release QA ad evidence only; use ISO 3166-1 alpha-2.
EXPO_PUBLIC_ADMOB_REQUEST_COUNTRY=

# Use only in signed sandbox builds. Production readiness fails while this is true.
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=false

# CLARA AI coach. Use a server endpoint so model/API secrets stay off device.
# Client remote AI timeouts are clamped between 1000ms and 12000ms.
EXPO_PUBLIC_AI_COACH_MODE=local
# EXPO_PUBLIC_AI_COACH_MODE=remote
# For release, use an HTTPS deployed app origin with a concrete route path, for example:
# EXPO_PUBLIC_AI_COACH_ENDPOINT=https://your-eas-hosting-domain.example/api/clara
EXPO_PUBLIC_AI_COACH_ENDPOINT=
EXPO_PUBLIC_AI_COACH_TIMEOUT_MS=8000

# Dynamic recovery challenge generation. Use the same server-side secret pattern.
EXPO_PUBLIC_AI_CHALLENGE_MODE=local
# EXPO_PUBLIC_AI_CHALLENGE_MODE=remote
# Release endpoints must be HTTPS and must not point to localhost or a .local host.
# EXPO_PUBLIC_AI_CHALLENGE_ENDPOINT=https://your-eas-hosting-domain.example/api/challenges
EXPO_PUBLIC_AI_CHALLENGE_ENDPOINT=
EXPO_PUBLIC_AI_CHALLENGE_TIMEOUT_MS=8000

# Adult-domain feed sync. Leave blank to use the embedded audited seed list.
# Point to app/api/adult-domain-feed after deploying a server-reviewed feed.
EXPO_PUBLIC_ADULT_DOMAIN_FEED_ENDPOINT=
# Device-side remote feed sync timeout; timeout falls back to embedded protection.
EXPO_PUBLIC_ADULT_DOMAIN_FEED_SYNC_TIMEOUT_MS=8000
# Local QA can use the embedded seed fallback. Production builds automatically
# require reviewed feed provenance; set true in signed sandbox QA to test it.
EXPO_PUBLIC_REQUIRE_REVIEWED_ADULT_DOMAIN_FEED=false
# Optional deployed feed smoke timeout.
FREED_ADULT_DOMAIN_FEED_SMOKE_TIMEOUT_MS=8000
# Firebase native foundation. Native app identifiers remain in the Android/iOS
# Google service files; never put Admin or service-account credentials in EXPO_PUBLIC_*.
EXPO_PUBLIC_FIREBASE_ENV=production
EXPO_PUBLIC_FIREBASE_AUTH_CONTINUE_URL=https://freed-7d5ee.web.app/auth/callback
# Leave blank until a Firebase-ID-token-verifying backend endpoint is deployed.
EXPO_PUBLIC_FIREBASE_RECOVERY_BACKUP_SYNC_ENDPOINT=
# Legacy Supabase endpoint retained only for server compatibility; the native
# Firebase sign-in UI does not use it.
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_ENDPOINT=
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_TIMEOUT_MS=8000
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_RESPONSE_MAX_BYTES=2000000
# Legacy public Supabase config for server/smoke compatibility. Use anon/public
# credentials only; service-role keys stay server-side below.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=
EXPO_PUBLIC_SUPABASE_AUTH_TIMEOUT_MS=8000
EXPO_PUBLIC_SUPABASE_AUTH_RESPONSE_MAX_BYTES=128000
# Server-only optional additions for app/api/adult-domain-feed. Comma or newline separated.
FREED_ADULT_DOMAIN_FEED_EXTRA_DOMAINS=
# Server-only reviewed source feeds for app/api/adult-domain-feed ingestion.
# One HTTPS source per line: source-id|Display label|https://feed.example/path.txt
# Release preflight accepts reviewed source families: oisd-nsfw, stevenblack,
# cloudflare-family exports, or FREED-owned custom sources like freed-custom-release.
FREED_ADULT_DOMAIN_FEED_SOURCE_URLS=
FREED_ADULT_DOMAIN_FEED_VERSION=
FREED_ADULT_DOMAIN_FEED_GENERATED_AT=
# Server-side adult-feed source ingestion cache TTL. The route clamps this from
# 60 seconds to 24 hours.
FREED_ADULT_DOMAIN_FEED_CACHE_TTL_SECONDS=3600
# Per-source timeout for reviewed adult-domain feed fetches.
FREED_ADULT_DOMAIN_FEED_SOURCE_TIMEOUT_MS=8000

# Optional coarse weather context for challenge personalization. Disabled by
# default so local-first privacy declarations remain accurate; enable only after
# product/privacy review of the weather provider and store disclosures. When
# enabled, release preflight requires a production-safe HTTPS endpoint, not
# local, private, reserved, or placeholder.
EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_ENABLED=false
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_ENDPOINT=https://api.open-meteo.com/v1/forecast
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_TIMEOUT_MS=5000
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_RESPONSE_MAX_BYTES=128000

# Optional privacy-safe retention orchestration. The app works locally by default;
# remote mode should point to the aggregate-only app/api/retention route. If set
# for release, preflight rejects local/private/placeholder endpoints.
EXPO_PUBLIC_RETENTION_MODE=local
# EXPO_PUBLIC_RETENTION_MODE=remote
# EXPO_PUBLIC_RETENTION_ENDPOINT=https://your-eas-hosting-domain.example/api/retention
# Optional remote retention timeout is clamped between 1000ms and 12000ms.
EXPO_PUBLIC_RETENTION_ENDPOINT=
EXPO_PUBLIC_RETENTION_TIMEOUT_MS=7000

# Optional aggregate-only remote analytics. Disabled by app controls unless the
# user explicitly opts in; point to app/api/analytics only after privacy review.
# If set for release, preflight rejects local/private/placeholder endpoints.
# EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://your-eas-hosting-domain.example/api/analytics
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
EXPO_PUBLIC_ANALYTICS_TIMEOUT_MS=5000
EXPO_PUBLIC_ANALYTICS_RESPONSE_MAX_BYTES=256000
FREED_ANALYTICS_SMOKE_TIMEOUT_MS=8000
# Optional no-secret backend readiness smoke target. Leave blank locally; the
# smoke command can derive /api/backend/readiness from another deployed app route.
# EXPO_PUBLIC_BACKEND_READINESS_ENDPOINT=https://your-eas-hosting-domain.example/api/backend/readiness
EXPO_PUBLIC_BACKEND_READINESS_ENDPOINT=
EXPO_PUBLIC_BACKEND_READINESS_TIMEOUT_MS=8000

# Server-only secrets for app/api/* routes. Never expose these with EXPO_PUBLIC_.
# FREED prefers OpenAI for production personalization and keeps Gemini as an
# optional fallback. The 1000+ on-device challenge template library means most
# relapse moments are served locally and the API is only hit for personalization.
# Server AI provider calls are bounded between 500ms and 60s.
FREED_AI_PROVIDER=openai
FREED_AI_PROVIDER_TIMEOUT_MS=12000
FREED_AI_PROVIDER_RESPONSE_MAX_BYTES=1000000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Server-only Supabase analytics ingestion for app/api/analytics.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_MAINTENANCE_SECRET=
SUPABASE_ANALYTICS_TABLE=recovery_analytics_events
FREED_ANALYTICS_SUPABASE_TIMEOUT_MS=8000
FREED_BACKEND_PROVIDER_TIMEOUT_MS=8000
FREED_BACKEND_PROVIDER_RESPONSE_MAX_BYTES=1000000
# Optional deployed Supabase schema smoke timeout.
FREED_SUPABASE_SCHEMA_SMOKE_TIMEOUT_MS=8000

# Server-only Redis/Upstash route limits and backend job locks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only recovery-safe remote push dispatch. Never expose these with EXPO_PUBLIC_.
REMOTE_NOTIFICATION_DISPATCH_SECRET=
FREED_REMOTE_NOTIFICATION_PROVIDER_TIMEOUT_MS=8000
FREED_REMOTE_NOTIFICATION_PROVIDER_RESPONSE_MAX_BYTES=512000
FREED_REMOTE_NOTIFICATION_SMOKE_TIMEOUT_MS=8000
FCM_SERVER_KEY=
FCM_ACCESS_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.freed.recovery
APNS_ENV=sandbox
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_BASE64=
