{
  "name": "freed-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "./node_modules/.bin/tsc -p tsconfig.json && node --test lib/**/*.test.js",
    "test:emulator": "npm run build && ./node_modules/.bin/firebase emulators:exec --only auth,firestore,storage,functions \"node --test lib/**/*.test.js\""
  },
  "engines": { "node": "22" },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "firebase-tools": "14.7.0"
  }
}
