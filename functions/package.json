{
  "name": "freed-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "./node_modules/.bin/tsc -p tsconfig.json && node --test lib/**/*.test.js",
    "test:emulator": "npm run build && ./node_modules/.bin/firebase emulators:exec --only auth,firestore,storage,functions \"node --test lib/**/*.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "google-auth-library": "^10.9.0",
    "tldts": "^7.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "firebase-tools": "14.7.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
