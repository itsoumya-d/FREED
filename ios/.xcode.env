# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY contains the path to the node executable.
# Build scripts can supply FREED_NODE_BINARY because React Native's wrapper
# resets NODE_BINARY before sourcing this file.
if [ -n "${FREED_NODE_BINARY:-}" ]; then
  export NODE_BINARY="$FREED_NODE_BINARY"
elif [ -z "${NODE_BINARY:-}" ]; then
  export NODE_BINARY=$(command -v node)
else
  export NODE_BINARY
fi
