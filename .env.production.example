# FREED production release template.
# Copy to your release environment, fill real values, and keep server-only values out of client builds.
# Keep each active KEY= line unique; release preflight rejects duplicate active keys.

EXPO_PUBLIC_MONETIZATION_MODE=native

# Expo/EAS project metadata for production builds, submits, and legal web deploys.
# These values are public project/account identifiers, but keep them in the
# release env so the repo does not hard-code account-specific metadata.
# Obtain EAS_PROJECT_ID from the linked Expo project after `npx eas-cli init`
# or the Expo dashboard. EXPO_PROJECT_ID is accepted as a fallback alias.
EAS_PROJECT_ID=
EXPO_PROJECT_ID=
EXPO_OWNER=

# FREED uses native App Store / Google Play billing directly via expo-iap.
# No RevenueCat dependency is required — products are validated against the store with on-device
# StoreKit2 / BillingClient receipts plus a server entitlement check.
EXPO_PUBLIC_STORE_PROVIDER=native-iap
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=premium
EXPO_PUBLIC_PURCHASE_VERIFY_ENDPOINT=
# Client-side purchase verification timeout. Clamped between 500ms and 15s so
# native IAP fails closed instead of hanging the paywall or restore flow.
EXPO_PUBLIC_PURCHASE_VERIFY_TIMEOUT_MS=8000
# Client-side purchase verification response ceiling. Clamped between 1KB and 2MB.
EXPO_PUBLIC_PURCHASE_VERIFY_RESPONSE_MAX_BYTES=256000

# Optional legacy RevenueCat fallback only when explicitly selected.
# EXPO_PUBLIC_STORE_PROVIDER=revenuecat
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Store product identifiers for the v1 Core 3 launch.
EXPO_PUBLIC_IAP_PRODUCT_YEARLY=freed_premium_yearly
EXPO_PUBLIC_IAP_PRODUCT_MONTHLY=freed_premium_monthly
EXPO_PUBLIC_IAP_PRODUCT_LIFETIME=freed_premium_lifetime
# Future add-on products stay disabled for the v1 store launch. Uncomment only
# after the app UI, server verification, store metadata, and release gates are
# intentionally promoted for these plans.
# EXPO_PUBLIC_IAP_PRODUCT_FAMILY=freed_family_yearly
# EXPO_PUBLIC_IAP_PRODUCT_ACCOUNTABILITY=freed_accountability_monthly
# EXPO_PUBLIC_IAP_PRODUCT_AI_COACH=freed_ai_coach_monthly

# Server-only purchase verification credentials for app/api/purchases/verify.
# Never expose these with EXPO_PUBLIC_.
APP_STORE_BUNDLE_ID=app.freed.recovery
APP_STORE_SERVER_API_ENV=production
# Server-side App Store / Google Play provider request timeout. Clamped between
# 500ms and 15s so app/api/purchases/verify fails closed on stalled providers.
FREED_PURCHASE_VERIFY_PROVIDER_TIMEOUT_MS=8000
# Server-side App Store / Google Play provider response ceiling. Clamped between
# 1KB and 2MB so store verification cannot parse oversized provider payloads.
FREED_PURCHASE_VERIFY_PROVIDER_RESPONSE_MAX_BYTES=512000
# Prefer issuer/key/private-key credentials so the server can mint short-lived JWTs.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_PRIVATE_KEY_BASE64=
# Optional pre-minted fallback for short sandbox smoke runs.
APP_STORE_SERVER_API_JWT=
GOOGLE_PLAY_PACKAGE_NAME=app.freed.recovery
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
# Optional pre-minted fallback for short sandbox smoke runs.
GOOGLE_PLAY_ACCESS_TOKEN=

# iOS Release archive signing for App Store Connect/TestFlight artifacts.
# Keep Apple Distribution certificates, provisioning profiles, and any
# generated export options outside git. FREED_IOS_PROVISIONING_PROFILES_JSON is
# optional for manual signing and should map bundle IDs to profile names.
FREED_IOS_DEVELOPMENT_TEAM=
FREED_IOS_CODE_SIGN_STYLE=Automatic
FREED_IOS_CODE_SIGN_IDENTITY=Apple Distribution
FREED_IOS_PROFILE_SPECIFIER=
FREED_IOS_PROVISIONING_PROFILES_JSON=
FREED_IOS_ALLOW_PROVISIONING_UPDATES=false
FREED_REQUIRE_IOS_RELEASE_SIGNING=true

# Android upload signing for Play Console artifacts. Keep the keystore file out
# of git and point FREED_ANDROID_UPLOAD_STORE_FILE at the local CI/secure-runner
# path used for the final store build. Local QA APKs may omit these values and
# will remain debug-key signed; production release verification requires a
# keytool-inspectable non-debug upload keystore.
# Bootstrap helper:
# npm run setup:android-upload-keystore -- --generate-passwords
FREED_ANDROID_UPLOAD_STORE_FILE=
FREED_ANDROID_UPLOAD_STORE_PASSWORD=
FREED_ANDROID_UPLOAD_KEY_ALIAS=
FREED_ANDROID_UPLOAD_KEY_PASSWORD=
FREED_REQUIRE_ANDROID_RELEASE_SIGNING=true

# AdMob rewarded reset configuration. Test ads must stay false for production.
# App IDs must look like ca-app-pub-0000000000000000~0000000000.
# Rewarded unit IDs must look like ca-app-pub-0000000000000000/0000000000.
# Google sample publisher IDs are rejected by release readiness.
# Optional coarse country code for release QA/ad-mediation evidence only; use ISO 3166-1 alpha-2.
EXPO_PUBLIC_ADMOB_APP_ID_IOS=
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_RESET_UNIT_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_RESET_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REQUEST_COUNTRY=
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=false

# Production AI endpoints must be HTTPS, non-local, and include concrete route paths.
# Replace these placeholder hosts before any release or sandbox smoke run; release readiness rejects them.
# Client remote AI timeouts are clamped between 1000ms and 12000ms.
EXPO_PUBLIC_AI_COACH_MODE=remote
EXPO_PUBLIC_AI_COACH_ENDPOINT=https://your-deployed-origin.example/api/clara
EXPO_PUBLIC_AI_COACH_TIMEOUT_MS=8000

EXPO_PUBLIC_AI_CHALLENGE_MODE=remote
EXPO_PUBLIC_AI_CHALLENGE_ENDPOINT=https://your-deployed-origin.example/api/challenges
EXPO_PUBLIC_AI_CHALLENGE_TIMEOUT_MS=8000

# Adult-domain feed sync. Production should point to the deployed
# app/api/adult-domain-feed route after feed ingestion/review is enabled.
EXPO_PUBLIC_ADULT_DOMAIN_FEED_ENDPOINT=https://your-deployed-origin.example/api/adult-domain-feed
# Device-side remote feed sync timeout. Clamped between 50ms and 15s; timeout
# falls back to the embedded audited seed feed instead of blocking startup.
EXPO_PUBLIC_ADULT_DOMAIN_FEED_SYNC_TIMEOUT_MS=8000
# Device-side remote feed response ceiling. Clamped between 100KB and 10MB so
# a bad deployed feed cannot force oversized JSON parsing during startup.
EXPO_PUBLIC_ADULT_DOMAIN_FEED_RESPONSE_MAX_BYTES=5000000
# Production activation must prove the synced feed came from the reviewed remote
# source path instead of relying only on the embedded seed fallback.
EXPO_PUBLIC_REQUIRE_REVIEWED_ADULT_DOMAIN_FEED=true
# Optional deployed feed smoke timeout. Clamped between 50ms and 15s.
FREED_ADULT_DOMAIN_FEED_SMOKE_TIMEOUT_MS=8000
# Optional hosted encrypted backup sync endpoint. Requires Supabase Auth on-device;
# the client sends only encrypted backup envelopes, never passphrases. When set,
# release preflight requires a production-safe HTTPS API route.
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_ENDPOINT=https://your-deployed-origin.example/api/recovery-backup/sync
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_TIMEOUT_MS=8000
EXPO_PUBLIC_RECOVERY_BACKUP_SYNC_RESPONSE_MAX_BYTES=2000000
# Public Supabase anon config. EXPO_PUBLIC_SUPABASE_ANON_KEY is required for the
# Supabase schema smoke to prove public-client lockout on backend tables. The
# public URL/redirect are used when hosted encrypted backup sync is enabled.
# These are intentionally public anon credentials; never expose the service-role
# key with EXPO_PUBLIC_. Leave the redirect blank to use the native app scheme,
# or set it to freed://auth/callback / app.freed.recovery://auth/callback after
# registering the callback in Supabase Auth.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=
EXPO_PUBLIC_SUPABASE_AUTH_TIMEOUT_MS=8000
EXPO_PUBLIC_SUPABASE_AUTH_RESPONSE_MAX_BYTES=128000
# Server-only optional reviewed additions for app/api/adult-domain-feed.
FREED_ADULT_DOMAIN_FEED_EXTRA_DOMAINS=
# Server-only reviewed source feeds for daily adult-domain feed ingestion.
# Used by app/api/adult-domain-feed and by the deployable
# supabase/functions/adult-domain-feed-sync Edge Function.
# One HTTPS source per line: oisd-nsfw|OISD NSFW|https://reviewed-feed-origin/path.txt
# At least one reviewed production-safe source is required for release. Source
# IDs must identify a reviewed family: oisd-nsfw, stevenblack, cloudflare-family,
# or a FREED-owned reviewed custom source such as freed-custom-release.
FREED_ADULT_DOMAIN_FEED_SOURCE_URLS=
FREED_ADULT_DOMAIN_FEED_VERSION=
FREED_ADULT_DOMAIN_FEED_GENERATED_AT=
# Server-side adult-feed source ingestion cache TTL. Clamped by the route between
# 60 seconds and 24 hours so device syncs reuse reviewed source fetches.
FREED_ADULT_DOMAIN_FEED_CACHE_TTL_SECONDS=3600
# Per-source timeout for reviewed adult-domain feed fetches. Clamped between
# 50ms and 15s so a slow upstream cannot stall device feed sync.
FREED_ADULT_DOMAIN_FEED_SOURCE_TIMEOUT_MS=8000
# Per-source response-size ceiling for reviewed adult-domain feed fetches.
# Clamped between 10KB and 5MB so an oversized source cannot consume memory
# during app-route or Supabase Edge Function sync.
FREED_ADULT_DOMAIN_FEED_SOURCE_MAX_BYTES=2000000

# Optional coarse weather context for challenge personalization. Keep disabled
# unless the selected provider and App Store / Play privacy disclosures have
# been reviewed. When enabled, the app rounds coordinates before requesting
# weather, requires a configured production-safe HTTPS endpoint in release
# preflight, and sends only condition/temperature into challenge generation.
EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_ENABLED=false
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_ENDPOINT=https://api.open-meteo.com/v1/forecast
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_TIMEOUT_MS=5000
# EXPO_PUBLIC_CHALLENGE_WEATHER_CONTEXT_RESPONSE_MAX_BYTES=128000

# Retention orchestration remains local by default. Switch to remote only after
# privacy review of the aggregate-only app/api/retention route. Remote mode
# requires a production-safe HTTPS endpoint in release preflight.
EXPO_PUBLIC_RETENTION_MODE=local
# EXPO_PUBLIC_RETENTION_MODE=remote
# EXPO_PUBLIC_RETENTION_ENDPOINT=https://your-deployed-origin.example/api/retention
# Optional remote retention timeout is clamped between 1000ms and 12000ms.
EXPO_PUBLIC_RETENTION_ENDPOINT=
EXPO_PUBLIC_RETENTION_TIMEOUT_MS=7000

# Production aggregate-only analytics ingestion route. Runtime sharing remains
# disabled until explicit user opt-in, short retention, privacy disclosures,
# and the server-side Supabase sink are ready.
EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://your-deployed-origin.example/api/analytics
# Client-side analytics send timeout. Clamped between 250ms and 15s so opt-in
# sharing cannot hang the app if the deployed route stalls.
EXPO_PUBLIC_ANALYTICS_TIMEOUT_MS=5000
EXPO_PUBLIC_ANALYTICS_RESPONSE_MAX_BYTES=256000
FREED_ANALYTICS_SMOKE_TIMEOUT_MS=8000
# Public no-secret backend readiness route used by release smoke verification.
# If left blank, smoke:backend-readiness derives /api/backend/readiness from
# another deployed app endpoint, such as EXPO_PUBLIC_ANALYTICS_ENDPOINT.
EXPO_PUBLIC_BACKEND_READINESS_ENDPOINT=https://your-deployed-origin.example/api/backend/readiness
EXPO_PUBLIC_BACKEND_READINESS_TIMEOUT_MS=8000

# Server-only secrets for app/api/* routes. Never expose these with EXPO_PUBLIC_.
# OPENAI_API_KEY must be a real server-side OpenAI key. FREED_AI_PROVIDER can be
# openai or gemini; if omitted, the server route prefers OpenAI when configured
# and falls back to Google/Gemini env names. Short or placeholder values are rejected.
# Server AI provider calls are bounded between 500ms and 60s.
FREED_AI_PROVIDER=openai
FREED_AI_PROVIDER_TIMEOUT_MS=12000
# Server AI provider JSON responses are bounded between 10KB and 5MB.
FREED_AI_PROVIDER_RESPONSE_MAX_BYTES=1000000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Server-only Supabase analytics/backend infrastructure for app/api/* routes
# and supabase/functions/* Edge Function cron/admin jobs.
# Use a real service-role key and maintenance secret; placeholder/test/local
# values are rejected before release verification and at runtime.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_MAINTENANCE_SECRET=
SUPABASE_ANALYTICS_TABLE=recovery_analytics_events
# Server-side Supabase analytics insert timeout. Clamped between 250ms and 15s
# so app/api/analytics fails closed instead of waiting indefinitely.
FREED_ANALYTICS_SUPABASE_TIMEOUT_MS=8000
SUPABASE_ADULT_FEED_TABLE=adult_domain_feed_versions
SUPABASE_RECOVERY_BACKUP_TABLE=encrypted_recovery_backups
SUPABASE_RECOVERY_BACKUP_RETENTION_DAYS=365
SUPABASE_PURCHASE_AUDIT_TABLE=purchase_verification_events
SUPABASE_AI_EVENTS_TABLE=ai_backend_events
SUPABASE_JOB_RUNS_TABLE=backend_job_runs
# Shared Supabase/Redis backend provider timeout. Clamped between 500ms and 15s
# so route limits, locks, feed publication, and audit/job writes fail closed.
FREED_BACKEND_PROVIDER_TIMEOUT_MS=8000
# Shared Supabase/Redis backend provider JSON response ceiling. Clamped between
# 1KB and 5MB so backend provider helpers fail closed on oversized payloads.
FREED_BACKEND_PROVIDER_RESPONSE_MAX_BYTES=1000000
# Optional Supabase Edge Function cron lock TTL. Clamped between 1s and 1h;
# used with UPSTASH_REDIS_REST_* to prevent overlapping feed sync/cleanup jobs.
FREED_EDGE_JOB_LOCK_TTL_MS=600000
# Optional deployed Supabase schema smoke timeout. Clamped between 500ms and 15s
# so migration/table verification cannot hang release checks.
FREED_SUPABASE_SCHEMA_SMOKE_TIMEOUT_MS=8000

# Optional Redis/Upstash backend infrastructure for public-route rate limits,
# adult-feed sync locks, idempotency, and short-lived smoke/evidence jobs.
# Never cache browsing history, private notes, screenshots, transcripts,
# purchase tokens, receipts, support contacts, or exact location.
# Use a real REST token; placeholder/test/local values are rejected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only remote push provider credentials for server-triggered campaigns.
# Local reminders remain the default; push payloads must contain route/kind metadata only.
# FCM v1 credentials require FIREBASE_PROJECT_ID or a project_id in FIREBASE_SERVICE_ACCOUNT_JSON(_BASE64).
# Provider calls are bounded between 500ms and 15s so push dispatch fails closed.
REMOTE_NOTIFICATION_DISPATCH_SECRET=
FREED_REMOTE_NOTIFICATION_PROVIDER_TIMEOUT_MS=8000
# OAuth/provider JSON responses are bounded between 1KB and 2MB.
FREED_REMOTE_NOTIFICATION_PROVIDER_RESPONSE_MAX_BYTES=512000
FREED_REMOTE_NOTIFICATION_SMOKE_TIMEOUT_MS=8000
FCM_SERVER_KEY=
FCM_ACCESS_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.freed.recovery
APNS_ENV=production
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_BASE64=
